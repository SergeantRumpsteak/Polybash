#!/usr/bin/env python3
"""Zaehlt bei jedem Commit auf main die Build-Nummer in Polybash/spiel.py hoch (BUILD = Anzahl der Commits inkl. diesem).
Aktivieren (einmal pro Klon):  git config core.hooksPath hooks"""
import re
import subprocess
import sys

def git(*a):
    return subprocess.check_output(("git",) + a, text=True).strip()

# Nur auf main - oder auf Zuruf (POLYBASH_BUMP=1) fuer den Release-Commit im eigenen Branch, siehe docs/WORKFLOW.md
import os
if git("rev-parse", "--abbrev-ref", "HEAD") != "main" and os.environ.get("POLYBASH_BUMP") != "1":
    sys.exit(0)
try:
    n = int(git("rev-list", "--count", "HEAD")) + 1
except subprocess.CalledProcessError:
    n = 1
path = "Polybash/spiel.py"
with open(path, newline="", encoding="utf-8") as f:
    s = f.read()
t, k = re.subn(r"^BUILD = \d+", f"BUILD = {n}", s, count=1, flags=re.M)
if k and t != s:
    with open(path, "w", newline="", encoding="utf-8") as f:
        f.write(t)
    subprocess.check_call(["git", "add", path])
